NODE_ENV=production
HOST=0.0.0.0
PORT=1234

# ─── Authentication ────────────────────────────────────────────────
# Choose one strategy: none, password, oidc
AUTH_STRATEGY=none
AUTH_PASSWORD=
AUTH_SESSION_COOKIE_NAME=collabmd_auth
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_MS=

# ─── OIDC (Google) ────────────────────────────────────────────────
# Uncomment these lines and set values to enable Google SSO.
# AUTH_STRATEGY=oidc
# AUTH_OIDC_PROVIDER=google
# PUBLIC_BASE_URL=https://notes.example.com
# AUTH_OIDC_CLIENT_ID=your-google-client-id
# AUTH_OIDC_CLIENT_SECRET=your-google-client-secret
# AUTH_OIDC_ALLOWED_EMAILS=
# AUTH_OIDC_ALLOWED_DOMAINS=

# ─── OIDC (Azure / Microsoft Entra ID) ────────────────────────────
# Uncomment these lines and set values to enable Azure SSO.
# AUTH_STRATEGY=oidc
# AUTH_OIDC_PROVIDER=azure
# PUBLIC_BASE_URL=https://notes.example.com
# AUTH_OIDC_CLIENT_ID=your-azure-client-id
# AUTH_OIDC_CLIENT_SECRET=your-azure-client-secret
# AUTH_OIDC_TENANT_ID=your-azure-tenant-id
# AUTH_OIDC_ALLOWED_EMAILS=
# AUTH_OIDC_ALLOWED_DOMAINS=

# ─── OIDC (Custom) ────────────────────────────────────────────────
# Use a custom OIDC issuer by setting AUTH_OIDC_ISSUER_URL.
# AUTH_STRATEGY=oidc
# AUTH_OIDC_PROVIDER=google
# AUTH_OIDC_ISSUER_URL=https://your-oidc-provider.com
# PUBLIC_BASE_URL=https://notes.example.com
# AUTH_OIDC_CLIENT_ID=your-client-id
# AUTH_OIDC_CLIENT_SECRET=your-client-secret

BASE_PATH=
WS_BASE_PATH=/ws
PUBLIC_WS_BASE_URL=
PLANTUML_SERVER_URL=https://www.plantuml.com/plantuml
COLLABMD_WIKI_LINK_AUTO_CREATE=true
# ─── Git (GitHub) ─────────────────────────────────────────────────
# Uncomment to sync vault with a git repository.
# COLLABMD_GIT_REPO_URL=git@github.com:ElementDataAu/element-data-notes.git
# COLLABMD_GIT_SSH_PRIVATE_KEY_FILE=/run/secrets/collabmd_git_key
# COLLABMD_GIT_SSH_KNOWN_HOSTS_FILE=/run/secrets/collabmd_known_hosts
# COLLABMD_GIT_USER_NAME=CollabMD Bot
# COLLABMD_GIT_USER_EMAIL=bot@elementdata.com.au
PERSISTENCE_DIR=data/rooms
ROOM_NAMESPACE=collabmd
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_HEADERS_TIMEOUT_MS=60000
HTTP_REQUEST_TIMEOUT_MS=30000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_BUFFERED_AMOUNT_BYTES=16777216
WS_MAX_PAYLOAD_BYTES=16777216
CLOUDFLARED_BIN=cloudflared
TUNNEL_TARGET_HOST=127.0.0.1
TUNNEL_TARGET_PORT=1234
TUNNEL_TARGET_URL=
CLOUDFLARED_EXTRA_ARGS=

# docker compose helpers
COLLABMD_IMAGE=collabmd:local
HOST_VAULT_DIR=./data/vault
COLLABMD_HOST_PORT=1234
PLANTUML_HOST_PORT=18080
